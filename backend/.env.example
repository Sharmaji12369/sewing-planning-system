# Copy this file to .env and put your own values in it. .env is never committed.
#
# PostgreSQL. The database and its tables are created on first start.
# Characters like @ # / : % ? & in the password are written %40 %23 %2F %3A %25 %3F %26.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/sewing_planning

# Port the API listens on. The frontend proxies /api/* here.
PORT=4000

# Signs the session cookies. `npm run set-login -- Admin "<password>"` creates it
# (and the first administrator) if it is missing - you need not type one.
# AUTH_SECRET=
# How long a sign-in lasts, in hours (default 168 = 7 days).
# SESSION_HOURS=168

# Optional: the AI model behind the assistant (Ollama). Without a key the
# assistant still answers everything from the board; only the written AI
# answers are off. OLLAMA_MODEL defaults to gpt-oss:120b.
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b
