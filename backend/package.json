{
  "name": "sewing-planning-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API and PostgreSQL schema for the Sewing Planning System",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "import": "tsx scripts/import-xlsm.ts",
    "set-login": "tsx scripts/set-login.ts",
    "test": "tsx --test test/planning.test.ts test/assistant.test.ts test/advisor.test.ts test/auth.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
